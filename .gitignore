# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage

# next.js
.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# env files are ignored above; the example lists names only
!.env.example

# private @bombappetit/cloud package, synced in at build time
/apps/web/.cloud/
/apps/web/public/cloud/

# test output
/apps/web/e2e/.results/
/apps/web/test-results/
/apps/web/playwright-report/

# decision logs
.audit/
decisions.tsv
