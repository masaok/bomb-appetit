{
  "name": "bomb-appetit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter web e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "rules:freeze": "pnpm --filter @bombappetit/engine rules:freeze",
    "cloud:sync": "pnpm --filter web cloud:sync",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:seed": "pnpm --filter web db:seed"
  },
  "packageManager": "pnpm@12.8.1"
}
