{
  "name": "bomb-appetit",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "start": "pnpm --filter web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter web e2e",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "rules:freeze": "pnpm --filter @bombappetit/engine rules:freeze",
    "cloud:sync": "pnpm --filter web cloud:sync",
    "db:generate": "pnpm --filter web db:generate",
    "db:migrate": "pnpm --filter web db:migrate",
    "db:seed": "pnpm --filter web db:seed",
    "boards:lock": "pnpm --filter web boards:lock",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "packageManager": "pnpm@12.8.1",
  "devDependencies": {
    "husky": "^9",
    "lint-staged": "^17",
    "prettier": "^3"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,json,md,yml,css}": "prettier --write"
  },
  "engines": {
    "node": ">=22"
  }
}
