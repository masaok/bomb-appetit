# Names only. Real values live in Vercel env vars and in an untracked .env.local.
# Everything here is optional: with none of it set, `pnpm dev` runs the full game
# with guest play, no rooms and no saved runs.

# Neon Postgres. Enables rooms, saved runs, missions progress and leaderboards.
DATABASE_URL=

# Signs guest cookies and run tickets. Required in production.
AUTH_SECRET=

# GitHub sign-in (Auth.js). Only needed for named leaderboard entries and admin.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Pusher Channels. Without these, rooms fall back to polling.
PUSHER_APP_ID=
PUSHER_SECRET=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Protects /api/cron/cleanup. Vercel Cron sends it as a bearer token.
CRON_SECRET=

# The private @bombappetit/cloud package. Set one of these, or neither to use the stub.
BOMBAPPETIT_CLOUD_PATH=
BOMBAPPETIT_CLOUD_TOKEN=
